<?php
/**
 * Redesigned Event (16) item page (Designs/item-child.html).
 * Rendered from view/omeka/site/item/show.phtml for that template only; the
 * page chrome (header/footer) comes from view/layout/layout.phtml.
 *
 * Events carry no media of their own: the hero image is borrowed from a related
 * Document, and the results grid holds the Documents and Photographs that
 * reference this Event. The back-link bar points at the Event's Organization.
 *
 * @var \Omeka\Api\Representation\ItemRepresentation $item
 */
$escape = $this->plugin('escapeHtml');
// Not "item": .item .item-hero-grid / .item .hero-title in site.css restyle the
// full-size hero, which the condensed child layout must not inherit.
$this->htmlElement('body')->appendAttribute('class', 'item-child');

$relations = $this->ItemRelations();

// Document title: site - hero label - hero title (see view/layout/layout.phtml).
$this->placeholder('documentTitle')->set(
    'מאגר מידע קרמיקה ישראלית - אירועים - ' . $item->displayTitle()
);

// Perf probe: ?irdebug=N&probe=TOKEN (see helper/PerfProbe.php). Stages:
//   1 = parentResource, 2 = creatorGroups, 3 = relatedDocsAndPhotos (3 = full run).
$probe = $this->PerfProbe()->begin('irdebug');

// No borrowable Document image: fall back to the per-template placeholder. The
// markup flags it so the hero renders it small (200px), not filling the column.
$heroImage = $relations->eventThumbnail($item, 'large');
$heroIsPlaceholder = !$heroImage;
$heroImage = $heroImage ?: $this->ResourcePlaceholder($item);
$description = $item->value('dcterms:description');
$date = $item->value('dcterms:date');

// Static hero chips: the kind of event, and the domain it was made for.
$chips = [];
foreach (['dcterms:type', 'cidoc:P19i_was_made_for'] as $term) {
    foreach ((array) $item->value($term, ['all' => true]) as $value) {
        $chip = trim((string) $value);
        if ($chip !== '' && !in_array($chip, $chips, true)) {
            $chips[] = $chip;
        }
    }
}

$parent = $relations->parentResource($item);
$probe->stage(1, 'parentResource', $parent ? $parent->id() : null);
$creatorGroups = $relations->creatorGroups($item);
$probe->stage(2, 'creatorGroups', count($creatorGroups));
$related = $relations->relatedDocsAndPhotos([$item]);
$probe->stage(3, 'relatedDocsAndPhotos', count($related));

// Expandable "show more" details drawer. The creator-role properties are
// deliberately absent — they are already rendered as the creators cloud.
$detailGroups = [
    ['label' => 'ארגונים מוזכרים', 'term' => 'ceramic:mentionedOrganization'],
    ['label' => 'א/נשים מוזכרים', 'term' => 'ceramic:mentionedPerson'],
];
$detailRows = [];
foreach ($detailGroups as $group) {
    $values = $item->value($group['term'], ['all' => true]);
    if ($values) {
        $detailRows[] = ['label' => $group['label'], 'values' => $values];
    }
}
$externalLinks = $item->value('bibo:uri', ['all' => true]);
$hasDetails = $detailRows || $externalLinks;

$partial = $this->plugin('partial');
$renderCard = function ($resource) use ($partial) {
    echo $partial('common/archive-item-card', ['resource' => $resource]);
};
?>

<?php if ($parent): ?>
<div class="item-parent-bar section-container">
    <a href="<?php echo $escape($parent->url()); ?>" class="item-parent-link">
        <i class="ph-light ph-arrow-right"></i>
        <span>חזרה אל: <?php echo $escape($parent->displayTitle()); ?></span>
    </a>
</div>
<?php endif; ?>

<section class="section-container item-hero-grid condensed">
    <?php if ($heroImage): ?>
    <div class="hero-visual small-thumb<?php echo $heroIsPlaceholder ? ' is-placeholder' : ''; ?>">
        <img src="<?php echo $escape($heroImage); ?>" alt="<?php echo $escape($item->displayTitle()); ?>">
    </div>
    <?php endif; ?>

    <div class="hero-text">
        <p class="hero-label">אירועים</p>
        <h1 class="hero-title"><?php echo $escape($item->displayTitle()); ?></h1>
        <?php if ($date): ?>
        <p class="hero-dates"><?php echo $escape((string) $date); ?></p>
        <?php endif; ?>
        <?php if ($chips): ?>
        <p class="hero-anchors hero-anchors-static" aria-label="סוג אירוע">
            <?php foreach ($chips as $chip): ?>
            <span class="hero-anchor-static-item"><?php echo $escape($chip); ?></span>
            <?php endforeach; ?>
        </p>
        <?php endif; ?>
        <?php if ($description): ?>
        <div class="hero-description">
            <p><?php echo $escape((string) $description); ?></p>
        </div>
        <?php endif; ?>

        <?php foreach ($creatorGroups as $group): ?>
        <div class="creators-sidebar-wrap">
            <?php if ($group['label'] !== ''): ?>
            <h3 class="creators-mini-header"><?php echo $escape($group['label']); ?></h3>
            <?php endif; ?>
            <div class="creators-link-cloud">
                <?php foreach ($group['agents'] as $agent): ?>
                <a href="<?php echo $escape($agent->url()); ?>"><?php echo $escape($agent->displayTitle()); ?></a>
                <?php endforeach; ?>
            </div>
        </div>
        <?php endforeach; ?>

        <?php if ($hasDetails): ?>
        <div id="item-details-drawer" class="details-closed">
            <?php if ($externalLinks): ?>
            <div class="external-links">
                <?php foreach ($externalLinks as $value) { echo $value->asHtml(); } ?>
            </div>
            <?php endif; ?>
            <?php foreach ($detailRows as $row): ?>
            <p class="item-type-grid"><?php echo $escape($row['label']); ?></p>
            <?php foreach ($row['values'] as $value): ?>
            <p class="item-name"><?php echo $value->asHtml(); ?></p>
            <?php endforeach; ?>
            <?php endforeach; ?>
        </div>
        <button id="toggle-item-details" class="details-toggle-btn" aria-expanded="false">
            להציג עוד +
        </button>
        <?php endif; ?>
    </div>
</section>

<?php if ($related): ?>
<hr class="group-divider">

<section class="section-container" id="related-items">
    <div class="view-controls">
        <h3 class="related-title">מדיה</h3>
        <div class="view-controls-actions">
            <div class="switcher-buttons">
                <button id="grid-view-btn" class="active" aria-label="תצוגת רשת"><i class="ph-light ph-squares-four"></i></button>
                <button id="list-view-btn" aria-label="תצוגת רשימה"><i class="ph-light ph-list"></i></button>
            </div>
        </div>
    </div>

    <div id="results-container" class="is-grid">
        <div class="result-section">
            <div class="group-content">
                <?php foreach ($related as $resource) { $renderCard($resource); } ?>
            </div>
        </div>
    </div>
</section>
<?php endif; ?>

<?php if ($this->getHelperPluginManager()->has('commentForm')): ?>
<section class="section-container item-feedback-section">
    <div class="item-feedback-card">
        <p class="item-feedback-kicker">חסר לנו מידע?</p>
        <p class="item-feedback-copy">אם יש לכם פרטים נוספים, הקשרים או תיקונים לגבי &ldquo;<?php echo $escape($item->displayTitle()); ?>&rdquo;, נשמח לשמוע מכם.</p>
        <div class="item-feedback-form">
            <?php echo $this->commentForm($item); ?>
        </div>
    </div>
</section>
<?php endif; ?>
