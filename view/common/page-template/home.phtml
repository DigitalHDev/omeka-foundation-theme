<?php
/**
 * Home page template (home-page-plan.md section 5). Ignores the page's blocks
 * and composes four sections from live API queries:
 *   1. Hero banner (random media attached to the banner item)
 *   2. Search strip (title-contains, all types)
 *   3. Discover grid (one image-bearing item per type + live counts)
 *   4. Selected items masonry (Documents/Photographs whose Event belongs to an
 *      Organization in item set 4211)
 */
$escape = $this->plugin('escapeHtml');
$this->htmlElement('body')->appendAttribute('class', 'home');

// Perf probe: ?hgdebug=N&probe=TOKEN dumps stage timings (both template- and
// request-relative), per-stage query counts and an environment report as plain
// text, then stops before stage N+1. See helper/PerfProbe.php.
//   1 = pool, 2 = hero, 3 = discover tiles; add &selected_items=1 for stage 4
$probe = $this->PerfProbe()->begin('hgdebug');

$graph = $this->HomeGraph();
$probe->attach($graph);

$browseUrl = $this->url('site/resource', ['controller' => 'item', 'action' => 'browse'], true);
$typeUrl = function ($id) use ($browseUrl) {
    return $browseUrl . '?resource_template_id[0]=' . $id;
};

$orgItemSetId = 4211; // Organizations item set scoping the "Selected items" grid.
$bannerItemId = 4248; // Item whose attached media supply the hero banner images.
$selectedMax = 32;    // 4 batches of 8.

// --- Async fragment -------------------------------------------------------
// site.js re-requests this page with ?selected_items=1 and injects the result
// into the masonry grid, so the first paint does not wait on the graph walk.
// Themes cannot register routes, hence the same-page fragment.
if ($this->params()->fromQuery('selected_items')) {
    $selected = $graph->orgDescendantPool($orgItemSetId, $selectedMax);
    $probe->stage(4, 'selected items', count($selected));
    while (ob_get_level()) {
        ob_end_clean();
    }
    header('Content-Type: text/html; charset=utf-8');
    foreach ($selected as $item) {
        printf(
            '<div class="grid-item"><a href="%s" class="item-link">'
                . '<div class="masonry-image-wrapper"><img src="%s" alt=""></div>'
                . '<p>%s</p></a></div>',
            $escape($item->url()),
            $escape($item->thumbnailDisplayUrl('large')),
            $escape($this->ComposeResourceTitle($item))
        );
    }
    exit;
}

// Discover categories, in mockup order.
$discoverTypes = [
    ['id' => 17, 'label' => 'אנשים'],
    ['id' => 16, 'label' => 'אירועים'],
    ['id' => 15, 'label' => 'מסמכים'],
    ['id' => 18, 'label' => 'ארגונים'],
];

// One shared pool of image-bearing Documents/Photographs feeds the
// Discover tiles. Kept small: every pool item costs a thumbnail lookup.
$pool = $graph->imagePool(60);
$usedSourceIds = [];
$probe->stage(1, 'pool', count($pool));

// --- Hero -----------------------------------------------------------------
// Banner images live as attached media on item 4248; one is picked at random
// per request.
$heroImageUrl = null;
$heroCaption = '';
try {
    $bannerItem = $this->api()->read('items', $bannerItemId)->getContent();
    $bannerMedia = array_values(array_filter($bannerItem->media(), function ($media) {
        return (bool) $media->thumbnailDisplayUrl('large');
    }));
    if ($bannerMedia) {
        $heroMedia = $bannerMedia[random_int(0, count($bannerMedia) - 1)];
        $heroImageUrl = $heroMedia->thumbnailDisplayUrl('large');
        $titleValue = $heroMedia->value('dcterms:title');
        $heroCaption = $titleValue ? (string) $titleValue : '';
    }
} catch (\Omeka\Api\Exception\NotFoundException $e) {
    // Banner item missing in this environment: render the hero without an image.
}
$probe->stage(2, 'hero');

// --- Discover tiles -------------------------------------------------------
$discoverTiles = [];
foreach ($discoverTypes as $type) {
    $tile = $graph->discoverTile($type['id'], $pool, $usedSourceIds);
    if ($tile) {
        $usedSourceIds[] = $tile['sourceId'];
    }
    $discoverTiles[] = [
        'type' => $type,
        'count' => $graph->typeCount($type['id']),
        'tile' => $tile,
    ];
}
$probe->stage(3, 'discover tiles', count($discoverTiles));

$selectedUrl = $this->url(null, [], ['query' => ['selected_items' => 1]], true);
?>

<div class="hero-section">
    <div class="hero-image">
        <?php if ($heroImageUrl): ?>
        <img src="<?php echo $escape($heroImageUrl); ?>" alt="">
        <?php endif; ?>
        <?php if ($heroCaption !== ''): ?>
        <div class="hero-caption"><?php echo $escape($heroCaption); ?></div>
        <?php endif; ?>
    </div>
</div>

<div class="search-bar">
    <form class="search-input-wrapper" action="<?php echo $escape($browseUrl); ?>" method="GET" role="search">
        <input type="hidden" name="property[0][property]" value="1">
        <input type="hidden" name="property[0][type]" value="in">
        <input type="text" name="property[0][text]" placeholder="הקלידו מילים לחיפוש במאגר" aria-label="<?php echo $escape($this->translate('Search the database')); ?>">
        <button type="submit" class="search-icon" aria-label="<?php echo $escape($this->translate('Search')); ?>"><i class="ph-light ph-magnifying-glass"></i></button>
    </form>
</div>

<hr class="divider">

<section class="section-container">
    <h2 class="section-title">גלו את המאגר</h2>
    <div class="discover-grid">
        <?php foreach ($discoverTiles as $entry): ?>
        <?php $label = $entry['type']['label'] . ' (' . $entry['count'] . ')'; ?>
        <div class="discover-item">
            <a href="<?php echo $escape($typeUrl($entry['type']['id'])); ?>" class="label label-link"><?php echo $escape($label); ?></a>
            <?php if ($entry['tile']): ?>
            <?php $resource = $entry['tile']['resource']; ?>
            <a href="<?php echo $escape($resource->url()); ?>" class="item-link">
                <div class="image-box"><img src="<?php echo $escape($entry['tile']['imageUrl']); ?>" alt=""></div>
                <p><?php echo $escape($this->ComposeResourceTitle($resource)); ?></p>
            </a>
            <?php endif; ?>
        </div>
        <?php endforeach; ?>
    </div>
</section>

<hr class="divider" id="selected-items-divider" hidden>

<section class="section-container" id="selected-items-section" hidden>
    <h2 class="section-title">פריטים נבחרים</h2>
    <div class="masonry-grid" data-initial="8" data-batch="8" data-src="<?php echo $escape($selectedUrl); ?>">
        <div class="grid-sizer"></div>
    </div>
    <div class="load-more-container" hidden>
        <button id="load-more">טען עוד פריטים</button>
    </div>
</section>
