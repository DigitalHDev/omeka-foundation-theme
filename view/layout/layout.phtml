<?php
$escape = $this->plugin('escapeHtml');
$siteTitle = $site->title();
$stylesheet = $this->themeSetting('stylesheet');

$this->htmlElement('html')->setAttribute('lang', $this->lang());
$this->htmlElement('html')->setAttribute('dir', 'rtl');
$this->headMeta()->setCharset('utf-8');
$this->headMeta()->appendName('viewport', 'width=device-width, initial-scale=1');
// Force a single, fixed document title on every page, overriding anything
// individual page templates may have appended to the headTitle container.
$this->headTitle()->set('מאגר קרמיקה ישראלית');

// Base Foundation stylesheet (still used by browse/item pages being redesigned
// separately); the new design system in css/site.css is appended last so it wins.
if (isset($stylesheet)) {
    $this->headLink()->appendStylesheet($this->assetUrl("css/$stylesheet.css"));
} else {
    $this->headLink()->appendStylesheet($this->assetUrl('css/default.css'));
}
$this->headLink()->prependStylesheet($this->assetUrl('css/iconfonts.css', 'Omeka'));
// Design dependencies: Typekit fonts + the ported design system.
$this->headLink()->appendStylesheet('https://use.typekit.net/zfc8qpg.css');
$this->headLink()->appendStylesheet($this->assetUrl('css/site.css'));

// Scripts. jQuery / global / Foundation come from core (prepended to run first).
$this->headScript()->prependFile($this->assetUrl('vendor/foundation/foundation.min.js'));
$this->headScript()->prependFile($this->assetUrl('js/global.js', 'Omeka'));
$this->headScript()->prependFile($this->assetUrl('vendor/jquery/jquery.min.js', 'Omeka'));
// Phosphor icons, Masonry + imagesLoaded (used by the home "Selected items"
// grid), and the theme's chrome/home script.
$this->headScript()->appendFile('https://unpkg.com/@phosphor-icons/web');
$this->headScript()->appendFile('https://unpkg.com/imagesloaded@5/imagesloaded.pkgd.min.js');
$this->headScript()->appendFile('https://unpkg.com/masonry-layout@4/dist/masonry.pkgd.min.js');
$this->headScript()->appendFile($this->assetUrl('js/site.js'));

$this->trigger('view.layout');
$this->jsTranslate();
$userBar = $this->userBar();
if ($userBar) {
    $this->htmlElement('body')->appendAttribute('class', 'user-bar');
}
?>
<?php echo $this->doctype(); ?>
<?php echo $this->htmlElement('html'); ?>
    <head>
        <?php echo $this->headMeta(); ?>
        <?php echo $this->headTitle(); ?>
        <?php echo $this->headLink(); ?>
        <?php echo $this->headStyle(); ?>
        <?php echo $this->headScript(); ?>
    </head>

    <?php echo $this->htmlElement('body'); ?>
        <a id="skipnav" href="#content"><?php echo $this->translate('Skip to main content'); ?></a>
        <?php echo $userBar; ?>
        <header>
            <?php echo $this->partial('common/site-header'); ?>
        </header>
        <main id="content" role="main">
            <?php echo $this->content; ?>
        </main>
        <?php echo $this->partial('common/site-footer'); ?>
        <script>
          $(document).foundation();
        </script>
    </body>
</html>
